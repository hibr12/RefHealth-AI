# Groq generates every final text response. Keep credentials server-side.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Optional Groq models for media; configure only models enabled for your account.
LLM_VISION_MODEL=
LLM_AUDIO_MODEL=
# Browser speech falls back to Groq Orpheus when local voices fail.
# The Groq organization administrator must accept that model's terms first.
LLM_SPEECH_MODEL=canopylabs/orpheus-v1-english
LLM_SPEECH_VOICE=troy

# Gemini generates query and document embeddings for authorized retrieval.
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
