DATABASE_URL=postgresql://coecare:change-me@localhost:5432/coecare
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated exact frontend origins. Leave empty unless needed.
# For a second local Vite server: CORS_ADDITIONAL_ORIGINS=http://127.0.0.1:5174
CORS_ADDITIONAL_ORIGINS=
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=replace-with-matching-corecare-api-key
AI_TIMEOUT_MS=60000
# Must outlast the AI assistant's 80-second provider budget.
AI_ASSISTANT_TIMEOUT_MS=90000
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
